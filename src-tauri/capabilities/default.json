{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-exists",
    "fs:allow-app-read",
    "fs:allow-app-write",
    {
      "identifier": "fs:allow-app-write",
      "allow": [{ "path": "$RESOURCE/config.json" }]
    }
  ]
}